# Host paths (OpenClaw machine)
# OpenClaw compose project + runtime live at ${DATA_DIR}/openclaw
DATA_DIR=/srv/containers

# Public hostname for the OpenClaw Traefik router (no scheme)
OPENCLAW_HOST=

# Public hostname for the mood journal web UI (Traefik, no scheme)
MOOD_JOURNAL_HOST=

# Shared password for the mood journal web UI. Required by mood-journal-web.
MOOD_JOURNAL_WEB_PASSWORD=

# File-backend password for gog-data/keyring. Required by email-mcp and
# calendar-mcp. Must match the password that encrypted the existing keyring.
GOG_KEYRING_PASSWORD=

# deploy.sh
REMOTE_HOST=
REMOTE_USER=
SSH_KEY=
# Defaults to ${DATA_DIR}/openclaw if unset
REMOTE_DIR=
COMPOSE_PROJECT=openclaw
